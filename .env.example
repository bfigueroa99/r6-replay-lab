# Copia este archivo como .env y ajusta lo que necesites.

# --- Replays -----------------------------------------------------------------
# Carpeta MatchReplay de Siege. En Windows va con backslashes y sin comillas.
REPLAY_DIR=D:\Program Files (x86)\Steam\steamapps\common\Tom Clancy's Rainbow Six Siege\MatchReplay

# Segundos sin cambios en los .rec para considerar que la partida termino.
# Bajalo si importas partidas viejas a mano, subelo si el watcher se adelanta.
IMPORT_QUIET_SECONDS=60

# Cada cuanto revisa la carpeta el comando watch_replays.
WATCH_INTERVAL_SECONDS=20

# --- App ---------------------------------------------------------------------
# Muestra minima para que una fila aparezca en las tablas de agregados.
MIN_ROUNDS_DEFAULT=5

# Minutos sin jugar para cortar una sesion. Si juegas seguido con pausas largas,
# subelo; si haces sesiones cortas seguidas, bajalo.
SESSION_GAP_MINUTES=120

# Segundos para considerar que una muerte fue vengada. r6-dissect usa 3; las
# planillas de Pro League usan hasta 10. Si lo cambias, corre `manage.py recompute`.
TRADE_WINDOW_SECONDS=3

TIME_ZONE=America/Santiago

# --- Django ------------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=cambia-esto-si-lo-expones-fuera-de-tu-pc
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Datos -------------------------------------------------------------------
# DATA_DIR=./data
# SQLITE_PATH=./data/db.sqlite3
# OVERRIDES_PATH=./data/overrides.json

# --- Logs --------------------------------------------------------------------
LOG_LEVEL=INFO
# Sube a DEBUG para ver el detalle del parser (es MUY verboso).
PYDISSECT_LOG_LEVEL=WARNING
