{
  "appId": "cl.benjamin.r6replaylab",
  "productName": "R6 Replay Lab",
  "copyright": "MIT",
  "directories": {
    "output": "../packaging/installer",
    "buildResources": "electron"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../packaging/dist/r6-backend",
      "to": "backend"
    }
  ],
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "artifactName": "R6ReplayLab-${version}-setup.${ext}",
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "R6 Replay Lab",
    "deleteAppDataOnUninstall": false
  },
  "publish": null
}
